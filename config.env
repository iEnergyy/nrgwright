# Grafana Cloud Configuration
# Replace these with your actual Grafana Cloud credentials
GRAFANA_CLOUD_URL=https://your-instance.grafana.net
GRAFANA_CLOUD_API_KEY=your-api-key

# Metrics Server Configuration
METRICS_PORT=9090
METRICS_HOST=localhost

# Optional: Prometheus remote write URL (if using direct push)
PROMETHEUS_REMOTE_WRITE_URL=https://your-instance.grafana.net/api/prom/push 